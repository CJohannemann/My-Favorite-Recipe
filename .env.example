# Copy this file to .env and fill it in. .env is never committed to git.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Password for the site (the browser asks for it). Required when the app is
# reachable from other devices or the internet. Use something long.
APP_USER=cook
APP_PASSWORD=

# Only for Cloudflare Tunnel (see DEPLOY.md)
# TUNNEL_TOKEN=

# Optional
# GEMINI_MODEL=gemini-2.5-flash
# SCANS_PER_HOUR=30
# PORT=3000
